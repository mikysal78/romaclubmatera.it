# {{ ansible_managed }}
{% if enable_fastcgi_cache | bool %}
# Bypass cache per utenti loggati / POST / area admin
map $request_method $wp_skip_method { default 0; POST 1; }
{% endif %}
{# Il certificato lo deposita ansible-dns: si serve l'HTTPS solo se i file
   ci sono davvero. Un ssl_certificate che punta a un file inesistente non
   degrada il servizio, impedisce a nginx di partire del tutto. #}
{% set tls = (webserver_tls | default(true) | bool) and (webserver_tls_presente | default(false) | bool) %}
{% set nomi = wp_domain ~ (' www.' ~ wp_domain if wp_canonical != 'non-www' else '') %}
{% if tls %}

# Tutto quello che arriva in chiaro passa a HTTPS.
server {
    listen 80;
    listen [::]:80;
    server_name {{ nomi }};

    location / {
        return 301 https://$host$request_uri;
    }
}
{% endif %}

server {
{% if tls %}
    listen 443 ssl;
    listen [::]:443 ssl;
    http2 on;

    ssl_certificate     {{ webserver_tls_cert }};
    ssl_certificate_key {{ webserver_tls_key }};

    # Parametri da ssl-config.mozilla.org, scritti qui e non inclusi da
    # /etc/letsencrypt/: su questo host certbot non gira, e un include che
    # punta a una directory di un altro strumento e' una dipendenza nascosta.
    ssl_session_cache shared:SSL:10m;
    ssl_session_timeout 1d;
    ssl_session_tickets off;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_prefer_server_ciphers off;
    ssl_ciphers "ECDHE-ECDSA-AES128-GCM-SHA256:ECDHE-RSA-AES128-GCM-SHA256:ECDHE-ECDSA-AES256-GCM-SHA384:ECDHE-RSA-AES256-GCM-SHA384:ECDHE-ECDSA-CHACHA20-POLY1305:ECDHE-RSA-CHACHA20-POLY1305:DHE-RSA-AES128-GCM-SHA256:DHE-RSA-AES256-GCM-SHA384";
{% else %}
    listen 80;
    listen [::]:80;
{% endif %}
    server_name {{ nomi }};

    root {{ wp_root }};
    index index.php;

    server_tokens off;

    client_max_body_size {{ webserver_client_max_body_size }};
    access_log /var/log/nginx/{{ wp_domain }}.access.log;
    error_log  /var/log/nginx/{{ wp_domain }}.error.log;

{% if enable_fastcgi_cache | bool %}
    set $skip_cache 0;
    if ($wp_skip_method = 1) { set $skip_cache 1; }
    if ($query_string != "") { set $skip_cache 1; }
    if ($request_uri ~* "/wp-admin/|/xmlrpc.php|wp-.*.php|/feed/|index.php|sitemap(_index)?.xml") { set $skip_cache 1; }
    if ($http_cookie ~* "comment_author|wordpress_logged_in|wp-postpass|woocommerce_items_in_cart") { set $skip_cache 1; }
{% endif %}

    # Sicurezza: blocca file sensibili
    location = /xmlrpc.php { deny all; access_log off; log_not_found off; }
    location ~* /(?:wp-config\.php|readme\.html|license\.txt) { deny all; }
    location ~ /\.(?!well-known) { deny all; access_log off; log_not_found off; }
    location ~* ^/wp-content/uploads/.*\.(?:php|phtml|php\d)$ { deny all; }

    # Vecchi indirizzi ancora in classifica sui motori (vedi
    # webserver_redirect_permanenti): meglio un 301 che un 404.
{% for r in webserver_redirect_permanenti | default([]) %}
    location = {{ r.da }} { return 301 {{ 'https' if tls else 'http' }}://$host{{ r.a }}; }
{% endfor %}

    location / {
        try_files $uri $uri/ /index.php?$args;
    }

    location ~ \.php$ {
        include snippets/fastcgi-php.conf;
        fastcgi_pass unix:/run/php/php{{ php_version }}-fpm.sock;
{% if enable_fastcgi_cache | bool %}
        fastcgi_cache WORDPRESS;
        fastcgi_cache_valid 200 301 302 {{ fastcgi_cache_valid }};
        fastcgi_cache_bypass $skip_cache;
        fastcgi_no_cache $skip_cache;
        add_header X-FastCGI-Cache $upstream_cache_status;
{% endif %}
    }

    # Static assets con cache lunga
    location ~* \.(?:css|js|jpg|jpeg|gif|png|webp|svg|ico|woff2?|ttf|otf|mp4|pdf)$ {
        expires 30d;
        add_header Cache-Control "public, no-transform";
        access_log off;
    }

    location = /favicon.ico { log_not_found off; access_log off; }
    # robots.txt virtuale di WordPress (include la sitemap)
    location = /robots.txt  { try_files $uri /index.php?$args; log_not_found off; access_log off; }
{% if enable_phpmyadmin | default(false) | bool %}

    # phpMyAdmin (path non standard + Basic Auth)
    location /{{ phpmyadmin_alias }} {
        alias {{ phpmyadmin_install_dir | default('/usr/share/phpmyadmin') }};
        index index.php;
{% if phpmyadmin_basic_auth | default(true) | bool %}
        auth_basic "Area riservata";
        auth_basic_user_file /etc/nginx/.htpasswd-pma;
{% endif %}

        location ~ ^/{{ phpmyadmin_alias }}/(.+\.php)$ {
            alias {{ phpmyadmin_install_dir | default('/usr/share/phpmyadmin') }}/$1;
            fastcgi_pass unix:/run/php/php{{ php_version }}-fpm.sock;
            include snippets/fastcgi-php.conf;
            fastcgi_param SCRIPT_FILENAME {{ phpmyadmin_install_dir | default('/usr/share/phpmyadmin') }}/$1;
        }
        location ~* ^/{{ phpmyadmin_alias }}/(.+\.(?:css|js|png|gif|jpg|ico|woff2?|svg))$ {
            alias {{ phpmyadmin_install_dir | default('/usr/share/phpmyadmin') }}/$1;
            expires 7d;
        }
    }
{% endif %}
}
