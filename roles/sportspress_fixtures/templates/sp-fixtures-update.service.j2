{{ ansible_managed | comment }}
[Unit]
Description=Aggiorna calendario e classifiche SportsPress da football-data.org
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
User={{ sportspress_fixtures_wp_user }}
Group={{ sportspress_fixtures_wp_user }}
# Prima si creano gli eventi che ancora non ci sono (le coppe escono a
# sorteggio fatto), poi si aggiornano orari e risultati di tutti.
ExecStart={{ sportspress_fixtures_wp_cli }} eval-file {{ sportspress_fixtures_script_dir }}/create-fixtures.php --path={{ sportspress_fixtures_wp_path }}
ExecStart={{ sportspress_fixtures_wp_cli }} eval-file {{ sportspress_fixtures_script_dir }}/update-fixtures.php --path={{ sportspress_fixtures_wp_path }}
ExecStart={{ sportspress_fixtures_wp_cli }} eval-file {{ sportspress_fixtures_script_dir }}/update-standings.php --path={{ sportspress_fixtures_wp_path }}
Nice=10
PrivateTmp=true
NoNewPrivileges=true
ProtectSystem=full
